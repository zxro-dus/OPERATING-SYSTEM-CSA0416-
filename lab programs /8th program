#include <stdio.h>

#define MAXQ 100

int main(void) {
    
    int n = 4;
    int at[] = {0, 1, 2, 3};   /* arrival times (keep sorted ascending) */
    int bt[] = {5, 4, 2, 1};   /* burst times                           */
    int quantum = 2;           /* time quantum                          */
    /* --------------------------------------------------------- */

    int rem[n], ct[n], tat[n], wt[n], inq[n];
    int queue[MAXQ], front = 0, rear = 0, count = 0;
    int seg_pid[200], seg_start[200], seg_end[200], segs = 0;
    float total_wt = 0, total_tat = 0;

    for (int i = 0; i < n; i++) { rem[i] = bt[i]; inq[i] = 0; }

    int time = 0, completed = 0;

    /* enqueue everything that has arrived by t=0 */
    for (int i = 0; i < n; i++)
        if (at[i] <= time && !inq[i]) {
            queue[rear] = i; rear = (rear + 1) % MAXQ; count++; inq[i] = 1;
        }

    while (completed < n) {
        if (count == 0) {
            /* CPU idle: jump to the next arrival */
            int next = -1;
            for (int i = 0; i < n; i++)
                if (!inq[i] && rem[i] > 0 && (next == -1 || at[i] < next)) next = at[i];
            time = next;
            for (int i = 0; i < n; i++)
                if (at[i] <= time && !inq[i]) {
                    queue[rear] = i; rear = (rear + 1) % MAXQ; count++; inq[i] = 1;
                }
            continue;
        }

        int idx = queue[front];
        front = (front + 1) % MAXQ;
        count--;

        int run = rem[idx] < quantum ? rem[idx] : quantum;

        seg_pid[segs] = idx + 1;
        seg_start[segs] = time;
        time += run;
        rem[idx] -= run;
        seg_end[segs] = time;
        segs++;

        /* new arrivals during this slice go in BEFORE the preempted process */
        for (int i = 0; i < n; i++)
            if (at[i] <= time && !inq[i]) {
                queue[rear] = i; rear = (rear + 1) % MAXQ; count++; inq[i] = 1;
            }

        if (rem[idx] > 0) {
            queue[rear] = idx; rear = (rear + 1) % MAXQ; count++;
        } else {
            ct[idx] = time;
            tat[idx] = ct[idx] - at[idx];
            wt[idx] = tat[idx] - bt[idx];
            completed++;
        }
    }

    printf("Time quantum = %d\n\n", quantum);
    printf("%-8s %-8s %-8s %-12s %-8s %-12s\n",
           "Process", "Arrival", "Burst", "Completion", "Wait", "Turnaround");
    for (int i = 0; i < n; i++) {
        printf("P%-7d %-8d %-8d %-12d %-8d %-12d\n",
               i + 1, at[i], bt[i], ct[i], wt[i], tat[i]);
        total_wt += wt[i];
        total_tat += tat[i];
    }

    printf("\nAverage waiting time    : %.2f\n", total_wt / n);
    printf("Average turnaround time : %.2f\n", total_tat / n);

    printf("\nGantt Chart:\n");
    for (int i = 0; i < segs; i++)
        printf("| P%d (%d-%d) ", seg_pid[i], seg_start[i], seg_end[i]);
    printf("|\n");

    return 0;
}
