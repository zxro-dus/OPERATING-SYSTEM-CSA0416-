#include <stdio.h>

#define MAX 50

int main(void) {
    int n;
    int pid[MAX], burst[MAX], wait[MAX], tat[MAX], completion[MAX];
    float total_wait = 0, total_tat = 0;

    printf("Enter number of processes (max %d): ", MAX);
    if (scanf("%d", &n) != 1 || n < 1 || n > MAX) {
        printf("Invalid number of processes.\n");
        return 1;
    }

    for (int i = 0; i < n; i++) {
        pid[i] = i + 1;
        printf("Enter burst time for P%d: ", pid[i]);
        if (scanf("%d", &burst[i]) != 1 || burst[i] <= 0) {
            printf("Invalid burst time.\n");
            return 1;
        }
    }

    /* All arrive at t=0, so the first process starts immediately */
    wait[0] = 0;
    completion[0] = burst[0];

    for (int i = 1; i < n; i++) {
        wait[i] = completion[i - 1];          /* waits for everything before it */
        completion[i] = wait[i] + burst[i];
    }

    for (int i = 0; i < n; i++) {
        tat[i] = completion[i];               /* arrival = 0, so TAT = completion */
        total_wait += wait[i];
        total_tat += tat[i];
    }

    /* Results table */
    printf("\n%-8s %-8s %-8s %-12s %-12s\n",
           "Process", "Burst", "Wait", "Turnaround", "Completion");
    for (int i = 0; i < n; i++) {
        printf("P%-7d %-8d %-8d %-12d %-12d\n",
               pid[i], burst[i], wait[i], tat[i], completion[i]);
    }

    printf("\nAverage waiting time    : %.2f\n", total_wait / n);
    printf("Average turnaround time : %.2f\n", total_tat / n);

    /* Gantt chart */
    printf("\nGantt Chart:\n|");
    for (int i = 0; i < n; i++) printf("  P%d  |", pid[i]);
    printf("\n0");
    for (int i = 0; i < n; i++) printf("      %-2d", completion[i]);
    printf("\n");

    return 0;
}
