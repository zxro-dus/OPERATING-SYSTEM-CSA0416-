#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <unistd.h>
#include <sys/types.h>
#include <sys/ipc.h>
#include <sys/msg.h>
#include <sys/wait.h>

#define TEXT_SIZE 100

typedef struct {
    long mtype;               /* message type: must be > 0 */
    char mtext[TEXT_SIZE];    /* message body              */
} Message;

int main(void) {
    /* 1. Create the message queue */
    int msqid = msgget(IPC_PRIVATE, IPC_CREAT | 0666);
    if (msqid < 0) { perror("msgget"); return 1; }

    /* ---- Hardcoded messages: edit these to test other cases ---- */
    struct { long type; const char *text; } to_send[] = {
        {1, "Hello from parent"},
        {2, "This is a priority message"},
        {1, "Goodbye"}
    };
    int n = 3;
    /* ------------------------------------------------------------ */

    /* 2. Parent sends all messages to the queue */
    for (int i = 0; i < n; i++) {
        Message m;
        m.mtype = to_send[i].type;
        strcpy(m.mtext, to_send[i].text);
        if (msgsnd(msqid, &m, strlen(m.mtext) + 1, 0) < 0) {
            perror("msgsnd");
            return 1;
        }
        printf("Parent: sent     [type %ld] %s\n", m.mtype, m.mtext);
    }
    fflush(stdout);

    pid_t pid = fork();
    if (pid < 0) { perror("fork"); return 1; }

    if (pid == 0) {
        /* ---- Child: receiver ---- */
        Message m;

        /* msgtyp = 2 -> pick the first message of type 2, skipping the queue order */
        if (msgrcv(msqid, &m, TEXT_SIZE, 2, 0) < 0) { perror("msgrcv"); exit(1); }
        printf("Child : received [type %ld] %s\n", m.mtype, m.mtext);

        /* msgtyp = 0 -> take the oldest remaining message (FIFO) */
        for (int i = 0; i < n - 1; i++) {
            if (msgrcv(msqid, &m, TEXT_SIZE, 0, 0) < 0) { perror("msgrcv"); exit(1); }
            printf("Child : received [type %ld] %s\n", m.mtype, m.mtext);
        }
        exit(0);
    }

    /* ---- Parent: wait for the child, then clean up ---- */
    wait(NULL);
    msgctl(msqid, IPC_RMID, NULL);   /* remove the queue from the kernel */
    printf("Parent: child finished, queue removed\n");

    return 0;
}
